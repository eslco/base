
config status 'status'

config config 'config'
	option enabled '1'
	option start_delay '3'
	option scheduled_restart '0'
	option scheduled_restart_cron '0 * 3 * *'
	option test_profile '1'
	option fast_reload '1'
	option core_only '0'
	option profile 'file:ESNikki.cfg.yaml'

config proxy 'proxy'
	option enabled '1'
	option tcp_mode 'redirect'
	option ipv4_dns_hijack '1'
	option ipv6_dns_hijack '0'
	option ipv4_proxy '1'
	option ipv6_proxy '0'
	option fake_ip_ping_hijack '1'
	option router_proxy '1'
	option lan_proxy '1'
	list bypass_dscp '4'
	option bypass_china_mainland_ip '0'
	option proxy_tcp_dport '21 22 80 110 143 194 443 465 853 993 995 8080 8443'
	option proxy_udp_dport '123 443 8443'
	option tun_timeout '30'
	option tun_interval '1'
	list reserved_ip '0.0.0.0/8'
	list reserved_ip '10.0.0.0/8'
	list reserved_ip '127.0.0.0/8'
	list reserved_ip '100.64.0.0/10'
	list reserved_ip '169.254.0.0/16'
	list reserved_ip '172.16.0.0/12'
	list reserved_ip '192.168.0.0/16'
	list reserved_ip '224.0.0.0/4'
	list reserved_ip '240.0.0.0/4'
	list reserved_ip6 '::/128'
	list reserved_ip6 '::1/128'
	list reserved_ip6 '::ffff:0:0/96'
	list reserved_ip6 '100::/64'
	list reserved_ip6 '64:ff9b::/96'
	list reserved_ip6 '2001::/32'
	list reserved_ip6 '2001:10::/28'
	list reserved_ip6 '2001:20::/28'
	list reserved_ip6 '2001:db8::/32'
	list reserved_ip6 '2002::/16'
	list reserved_ip6 'fc00::/7'
	list reserved_ip6 'fe80::/10'
	list reserved_ip6 'ff00::/8'
	option bypass_china_mainland_ip6 '0'
	list lan_inbound_interface 'lan'
	option udp_mode 'tun'

config mixin 'mixin'
	option log_level 'warning'
	option mode 'rule'
	option ipv6 '0'
	option ui_url 'https://gh-proxy.com/https://github.com/Zephyruso/zashboard/releases/latest/download/dist-cdn-fonts.zip'
	option api_listen '[::]:9090'
	option selection_cache '1'
	option allow_lan '1'
	option http_port '7890'
	option socks_port '20087'
	option mixed_port '20083'
	option redir_port '7892'
	option tproxy_port '7894'
	option authentication '0'
	option tun_device 'nikki'
	option tun_stack 'mixed'
	option tun_dns_hijack '1'
	list tun_dns_hijacks 'tcp://any:53'
	list tun_dns_hijacks 'udp://any:53'
	option dns_listen '[::]:1053'
	option dns_mode 'fake-ip'
	option fake_ip_range '198.18.0.1/16'
	option fake_ip_filter '0'
	option hosts '1'
	option dns_nameserver '1'
	option dns_nameserver_policy '1'
	option sniffer_force_domain_name '1'
	option sniffer_ignore_domain_name '1'
	option sniffer_sniff '1'
	option rule '1'
	option rule_provider '0'
	option mixin_file_content '1'
	option ui_path 'ui'
	option ui_name 'zash'
	# option global_client_fingerprint 'chrome'
	option geoip_format 'mmdb'
	option geodata_loader 'standard'
	option geosite_url 'https://gh-proxy.com/https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/geosite.dat'
	option geoip_mmdb_url 'https://gh-proxy.com/https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/country-lite.mmdb'
	option geoip_dat_url 'https://gh-proxy.com/https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/geoip-lite.dat'
	option geoip_asn_url 'https://gh-proxy.com/https://github.com/xishang0128/geoip/releases/download/latest/GeoLite2-ASN.mmdb'
	option geox_auto_update '1'
	option geox_update_interval '48'
	option tcp_concurrent '1'
	option sniffer '1'
	option sniffer_sniff_dns_mapping '1'
	option sniffer_sniff_pure_ip '1'
	list sniffer_force_domain_names '+.claude.ai'
	list sniffer_force_domain_names '+.v2ex.com'
	list sniffer_force_domain_names '+.whatsapp.net'
	list sniffer_force_domain_names '+.whatsapp.com'
	list sniffer_force_domain_names '+.facebook.com'
	list sniffer_force_domain_names 'www.xiaohongshu.com'
	list sniffer_force_domain_names 'edith.xiaohongshu.com'
	list sniffer_force_domain_names 'search.xiaohongshu.com'
	list sniffer_force_domain_names '+.xiaohongshu.com'
	list sniffer_force_domain_names '+.xiaohongshu.net'
	list sniffer_force_domain_names '+.xhscdn.net'
	list sniffer_force_domain_names '+.xhscdn.com'
	list sniffer_ignore_domain_names '+.baidu.com'
	list sniffer_ignore_domain_names '+.msftconnecttest.com'
	list sniffer_ignore_domain_names '+.msftncsi.com'
	list sniffer_ignore_domain_names '+.market.xiaomi.com'
	list fake_ip_filters '+.lan'
	list fake_ip_filters '+.local'
	list fake_ip_filters '+.localhost'
	list fake_ip_filters '+.msftncsi.com'
	list fake_ip_filters '+.msftconnecttest.com'
	list fake_ip_filters '+.market.xiaomi.com'
	list fake_ip_filters 'rule-set:private_domain'
	list fake_ip_filters 'time.*.com'
	option fake_ip_filter_mode 'blacklist'
	option dns_respect_rules '1'
	option dns_doh_prefer_http3 '0'
	option dns_hosts '0'
	option dns_proxy_server_nameserver_policy '0'
#   option outbound_interface 'pppoe-wan'
	option dns_enabled '1'
	option dns_system_hosts '0'
	option dns_cache_algorithm 'arc'
	option dns_ipv6 '0'
	option tun_gso '1'

config router_access_control
	option enabled '1'
	list user 'dnsmasq'
	list user 'ftp'
	list user 'logd'
	list user 'nobody'
	list user 'ntp'
	list user 'ubus'
	list group 'dnsmasq'
	list group 'ftp'
	list group 'logd'
	list group 'nogroup'
	list group 'ntp'
	list group 'ubus'
	list cgroup 'aria2'
	list cgroup 'dnsmasq'
	option proxy '0'
	option dns '0'

config lan_access_control
	option enabled '1'
	option proxy '1'
	option dns '1'

config authentication
	option enabled '0'
	option username 'nikki'
	option password 'visa'

config hosts
	option enabled '1'
	option domain_name 'localhost'
	list ip '127.0.0.1'
	list ip '::1'

config nameserver
	option enabled '1'
	option type 'default-nameserver'
	list nameserver '223.6.6.6'
config nameserver
	option enabled '1'
	option type 'proxy-server-nameserver'
	list nameserver 'https://1.0.0.1/dns-query'
	list nameserver '8.8.4.4'

config nameserver
	option enabled '1'
	option type 'nameserver'
	list nameserver '119.29.29.29'

config nameserver
	option enabled '0'
	option type 'fallback'
	list nameserver 'https://223.6.6.6/dns-query'

config nameserver_policy
	option enabled '0'
	option matcher 'geosite:private,cn'
	list nameserver '223.5.5.5'

config nameserver_policy
	option enabled '0'
	option matcher 'geosite:geolocation-!cn'
	list nameserver 'https://8.8.4.4/dns-query'

config sniff
	option enabled '1'
	option protocol 'HTTP'
	list port '80'
	list port '8080'
	option overwrite_destination '1'

config sniff
	option enabled '1'
	option protocol 'TLS'
	list port '443'
	list port '8443'
	option overwrite_destination '1'

config sniff
	option enabled '1'
	option protocol 'QUIC'
	option overwrite_destination '1'
	list port '443'
	list port '8443'
	list port '5332'

config editor 'editor'

config log 'log'
	option scheduled_clear '1'
	option scheduled_clear_cron '* * /7 * *'
	option scheduled_clear_size_limit '3'
	option scheduled_clear_size_limit_unit 'MB'
	option clear_at_stop '0'

config subscription
	option name 'ESUB+'
	option url 'https://sub.example.com/sub?token=xxx&clash'
	option user_agent 'mihomo'
	option prefer 'remote'
	option update '2026-08-02 13:03:40'
	option success '1'

config procd 'procd'
	option fast_reload '1'
	option env_safe_paths 'etc/nikki/run'
	option env_disable_loopback_detector '1'
	option env_disable_quic_go_gso '1'
	option env_disable_quic_go_ecn '1'
	option env_skip_system_ipv6_check '1'

config router_access_control
	option enabled '1'
	option proxy '0'
	option dns '0'